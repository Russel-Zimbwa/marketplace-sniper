# Marketplace Sniper settings. The easiest way to fill these in is the setup wizard:
#   Windows: double-click CONFIGURE.bat     Mac/Linux: ./configure.sh
# Most of these can also be changed from Telegram (send "help" to your bot).

# --- Required ---
# Your Telegram bot token, from @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# Your Telegram chat. Blank = the first chat that messages the bot becomes its owner.
TELEGRAM_CHAT_ID=
# Facebook Marketplace location: the word after /marketplace/ in the address bar when you browse your area
LOCATION_ID=

# --- What gets sent ---
# Search radius in km
RADIUS_KM=10
# Also send exceptional steals (9/10+) from up to this many km away. 0 = off
FAR_RADIUS_KM=60
# Only listings posted within this many minutes are ever sent
FRESH_MINUTES=120
# Minimum deal score (1-10) to be sent
DEAL_THRESHOLD=7
# rules = only good deals; off = every new nearby listing
JUDGE=rules

# --- How often ---
# Seconds between checks of each item (random value between these two)
MIN_INTERVAL=60
MAX_INTERVAL=120
# Minutes between full re-scans used to learn prices
RESCAN_MINUTES=30

# --- Free AI photo check (needs Ollama: https://ollama.com, then: ollama pull gemma3:4b) ---
# Blank = use it automatically when Ollama is running; off = never
OLLAMA_MODEL=
OLLAMA_URL=http://localhost:11434
OLLAMA_TIMEOUT=180

# --- Not used by default: an older, paid Claude judge kept in mpwatch/judge_claude.py for anyone who wants to swap it in ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Troubleshooting ---
# false = show the browser window while it works
HEADLESS=true
# Browser to drive: chromium, chrome or msedge. Blank = try each in that order
BROWSER_CHANNEL=
